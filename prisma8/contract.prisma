// use prisma-8
// Contract inferred from the live database schema. Edit as needed, then run `prisma contract emit`.
namespace public {
  model User {
    id                           Int                   @id(map: "User_pkey") @default(autoincrement())
    email                        String
    name                         String?
    createdAt                    TimestampString(3)    @default(now())
    password                     String?
    role                         pg.enum(Role)         @default("USER")
    twoFactorEnabled             Boolean               @default(false)
    twoFactorSecret              String?
    updatedAt                    TimestampString(3)
    clockifyApiKey               String?
    clockifyUserId               String?
    clockifyWorkspaceId          String?
    hubspotAccessToken           String?
    hubspotPortalId              String?
    hubspotRefreshToken          String?
    hubspotTokenExpiresAt        TimestampString(3)?
    logoUrl                      String?
    adminPermissions             String[]?             @default([]) @noCheck(elementNotNull)
    defaultCurrency              String                @default("EUR")
    dateFormat                   String?               @default("DD/MM/YYYY")
    firstName                    String?
    hourFormat                   String?               @default("24h")
    interfaceLanguage            String?               @default("en")
    jobTitle                     String?
    lastName                     String?
    mobilePhone                  String?
    numberFormat                 String?               @default("1,234.56")
    googleCalendarAccessToken    String?
    googleCalendarEmail          String?
    googleCalendarRefreshToken   String?
    googleCalendarTokenExpiresAt TimestampString(3)?
    auditLogs                    AuditLog[]
    clients                      Client[]
    clientRates                  ClientRate[]
    clientStatusHistory          ClientStatusHistory[]
    invoices                     Invoice[]
    oauthAccounts                OAuthAccount[]
    occupations                  Occupation[]
    passwordResetTokens          PasswordResetToken[]
    projects                     Project[]
    rateSheets                   RateSheet[]
    refreshTokens                RefreshToken[]
    tags                         Tag[]
    taskActivities               TaskActivity[]
    taskComments                 TaskComment[]
    timeEntries                  TimeEntry[]
    translationRates             TranslationRate[]
    twoFactorBackupCodes         TwoFactorBackupCode[]

    @@index([email], map: "User_email_key", unique: true)
  }

  model AuditLog {
    id        Int                @id(map: "AuditLog_pkey") @default(autoincrement())
    userId    Int
    action    String
    resource  String
    payload   Jsonb?
    createdAt TimestampString(3) @default(now())
    user      User               @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "AuditLog_userId_fkey", index: false)
  }

  model Occupation {
    id                Int                     @id(map: "Occupation_pkey") @default(autoincrement())
    userId            Int
    name              String
    companyName       String?
    legalForm         String?
    professionalEmail String?
    professionalPhone String?
    website           String?
    timezone          String?
    objectiveQ1       Int?
    objectiveQ2       Int?
    objectiveQ3       Int?
    objectiveQ4       Int?
    createdAt         TimestampString(3)      @default(now())
    updatedAt         TimestampString(3)
    occupationType    pg.enum(OccupationType) @default("CUSTOM")
    charges           Charge[]
    clients           ClientOccupation[]
    customFields      CustomField[]
    languagePairs     LanguagePair[]
    projects          ProjectOccupation[]
    rateSheets        RateSheet[]
    timeEntries       TimeEntry[]
    translationRates  TranslationRate[]
    user              User                    @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "Occupation_userId_fkey", index: false)
  }

  model Charge {
    id           Int                 @id(map: "Charge_pkey") @default(autoincrement())
    occupationId Int
    name         String
    amount       Int
    _type        pg.enum(ChargeType) @map("type")
    occupation   Occupation          @relation(fields: [occupationId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "Charge_occupationId_fkey", index: false)
  }

  model Client {
    id                Int                      @id(map: "Client_pkey") @default(autoincrement())
    userId            Int
    name              String
    email             String?
    phone             String?
    company           String?
    address           String?
    notes             String?
    hubspotId         String?
    createdAt         TimestampString(3)       @default(now())
    updatedAt         TimestampString(3)
    city              String?
    country           String?
    legalName         String?
    postalCode        String?
    vatNumber         String?
    billingEndOfMonth Boolean                  @default(false)
    clientType        pg.enum(ClientType)      @default("COMPANY")
    firstName         String?
    lastName          String?
    paymentDelayDays  Int?
    taxRate           Numeric(5, 2)?
    industry          pg.enum(ClientIndustry)?
    website           String?
    linkedinUrl       String?
    contactedAt       TimestampString(3)?
    toRecontactAt     TimestampString(3)?
    status            pg.enum(ClientStatus)    @default("CLIENT")
    addressLine2      String?
    color             String?
    legalForm         String?
    state             String?
    occupations       ClientOccupation[]
    clientRates       ClientRate[]
    statusHistory     ClientStatusHistory[]
    tags              ClientTag[]
    contacts          CompanyContact[]
    invoices          Invoice[]
    projects          Project[]
    rateSheets        RateSheet[]
    translationRates  TranslationRate[]
    user              User                     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "Client_userId_fkey", index: false)
  }

  model ClientOccupation {
    clientId     Int
    occupationId Int
    client       Client     @relation(fields: [clientId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "ClientOccupation_clientId_fkey", index: false)
    occupation   Occupation @relation(fields: [occupationId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "ClientOccupation_occupationId_fkey", index: false)

    @@id([clientId, occupationId], map: "ClientOccupation_pkey")
  }

  model ClientRate {
    id          Int                @id(map: "ClientRate_pkey") @default(autoincrement())
    clientId    Int
    userId      Int
    _type       pg.enum(RateType)  @map("type")
    name        String
    amount      Numeric(10, 4)
    currency    String             @default("EUR")
    description String?
    createdAt   TimestampString(3) @default(now())
    updatedAt   TimestampString(3)
    client      Client             @relation(fields: [clientId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "ClientRate_clientId_fkey", index: false)
    user        User               @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "ClientRate_userId_fkey", index: false)
  }

  model ClientStatusHistory {
    id        Int                @id(map: "ClientStatusHistory_pkey") @default(autoincrement())
    clientId  Int
    userId    Int
    _type     String             @map("type")
    payload   String?
    createdAt TimestampString(3) @default(now())
    client    Client             @relation(fields: [clientId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "ClientStatusHistory_clientId_fkey", index: false)
    user      User               @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "ClientStatusHistory_userId_fkey", index: false)
  }

  model Tag {
    id        Int                @id(map: "Tag_pkey") @default(autoincrement())
    userId    Int
    name      String
    createdAt TimestampString(3) @default(now())
    clients   ClientTag[]
    entries   TimeEntryTag[]
    user      User               @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "Tag_userId_fkey", index: false)

    @@index([userId, name], map: "Tag_userId_name_key", unique: true)
  }

  model ClientTag {
    clientId Int
    tagId    Int
    client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "ClientTag_clientId_fkey", index: false)
    tag      Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "ClientTag_tagId_fkey", index: false)

    @@id([clientId, tagId], map: "ClientTag_pkey")
  }

  model CompanyContact {
    id        Int                @id(map: "CompanyContact_pkey") @default(autoincrement())
    clientId  Int
    firstName String?
    lastName  String?
    email     String?
    phone     String?
    createdAt TimestampString(3) @default(now())
    updatedAt TimestampString(3)
    color     String?
    jobTitle  String?
    linkedinUrl String?
    client    Client             @relation(fields: [clientId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "CompanyContact_clientId_fkey", index: false)
  }

  model CustomField {
    id           Int        @id(map: "CustomField_pkey") @default(autoincrement())
    occupationId Int
    key          String
    value        String
    occupation   Occupation @relation(fields: [occupationId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "CustomField_occupationId_fkey", index: false)
  }

  model Invoice {
    id        Int                    @id(map: "Invoice_pkey") @default(autoincrement())
    userId    Int
    clientId  Int?
    number    String
    status    pg.enum(InvoiceStatus) @default("DRAFT")
    currency  String                 @default("EUR")
    issuedAt  TimestampString(3)?
    dueDate   TimestampString(3)?
    paidAt    TimestampString(3)?
    notes     String?
    createdAt TimestampString(3)     @default(now())
    updatedAt TimestampString(3)
    items     InvoiceItem[]
    client    Client?                @relation(fields: [clientId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "Invoice_clientId_fkey", index: false)
    user      User                   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "Invoice_userId_fkey", index: false)

    @@index([userId, number], map: "Invoice_userId_number_key", unique: true)
  }

  model RateSheet {
    id             Int                @id(map: "RateSheet_pkey") @default(autoincrement())
    userId         Int
    clientId       Int?
    name           String
    description    String?
    sourceLanguage VarChar(2)
    targetLanguage VarChar(2)
    currency       String             @default("EUR")
    pricePerWord   Numeric(10, 6)
    matchRates     Jsonb
    createdAt      TimestampString(3) @default(now())
    updatedAt      TimestampString(3)
    occupationId   Int?
    isDefault      Boolean            @default(false)
    projects       Project[]
    client         Client?            @relation(fields: [clientId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "RateSheet_clientId_fkey", index: false)
    occupation     Occupation?        @relation(fields: [occupationId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "RateSheet_occupationId_fkey", index: false)
    user           User               @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "RateSheet_userId_fkey", index: false)
  }

  model Project {
    id             Int                    @id(map: "Project_pkey") @default(autoincrement())
    title          String
    description    String?
    userId         Int?
    clientId       Int?
    createdAt      TimestampString(3)     @default(now())
    currency       String                 @default("EUR")
    deadline       TimestampString(3)?
    sourceLanguage String?
    startDate      TimestampString(3)?
    status         pg.enum(ProjectStatus) @default("DRAFT")
    targetLanguage String?
    unitPrice      Numeric(14, 8)?
    updatedAt      TimestampString(3)
    wordCount      Int?
    fixedFee       Numeric(10, 4)?
    hourlyRate     Numeric(10, 4)?
    perWordRate    Numeric(10, 4)?
    useCustomRate  Boolean                @default(false)
    rateSheetId    Int?
    invoiceItems   InvoiceItem[]
    occupations    ProjectOccupation[]
    tasks          Task[]
    timeEntries    TimeEntry[]
    client         Client?                @relation(fields: [clientId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "Project_clientId_fkey", index: false)
    rateSheet      RateSheet?             @relation(fields: [rateSheetId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "Project_rateSheetId_fkey", index: false)
    user           User?                  @relation(fields: [userId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "Project_userId_fkey", index: false)
  }

  model Task {
    id              Int                 @id(map: "Task_pkey") @default(autoincrement())
    projectId       Int
    title           String
    description     String?
    status          pg.enum(TaskStatus) @default("TODO")
    dueDate         TimestampString(3)?
    sortOrder       Int                 @default(0)
    createdAt       TimestampString(3)  @default(now())
    updatedAt       TimestampString(3)
    checklistTitles String[]?           @noCheck(elementNotNull)
    recurring       String?
    reminderOffset  String?
    startDate       TimestampString(3)?
    wordCount       Int?
    color           String?
    subtasks        Subtask[]
    activities      TaskActivity[]
    attachments     TaskAttachment[]
    comments        TaskComment[]
    labels          TaskLabel[]
    timeEntries     TimeEntry[]
    project         Project             @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "Task_projectId_fkey", index: false)
  }

  model Subtask {
    id             Int                 @id(map: "Subtask_pkey") @default(autoincrement())
    taskId         Int
    title          String
    done           Boolean             @default(false)
    createdAt      TimestampString(3)  @default(now())
    updatedAt      TimestampString(3)
    dueDate        TimestampString(3)?
    checklistTitle String?
    wordCount      Int?
    timeEntries    TimeEntry[]
    task           Task                @relation(fields: [taskId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "Subtask_taskId_fkey", index: false)
  }

  model TimeEntry {
    id              Int                      @id(map: "TimeEntry_pkey") @default(autoincrement())
    userId          Int
    projectId       Int?
    description     String?
    startTime       TimestampString(3)
    endTime         TimestampString(3)?
    durationSeconds Int?
    billable        Boolean                  @default(true)
    clockifyEntryId String?
    createdAt       TimestampString(3)       @default(now())
    updatedAt       TimestampString(3)
    taskId          Int?
    subtaskId       Int?
    occupationId    Int?
    wordsProcessed  Int?
    invoicingStatus pg.enum(InvoicingStatus) @default("NO")
    invoiceItems    InvoiceItem[]
    activities      TaskActivity[]
    tags            TimeEntryTag[]
    occupation      Occupation?              @relation(fields: [occupationId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "TimeEntry_occupationId_fkey", index: false)
    project         Project?                 @relation(fields: [projectId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "TimeEntry_projectId_fkey", index: false)
    subtask         Subtask?                 @relation(fields: [subtaskId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "TimeEntry_subtaskId_fkey", index: false)
    task            Task?                    @relation(fields: [taskId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "TimeEntry_taskId_fkey", index: false)
    user            User                     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "TimeEntry_userId_fkey", index: false)
  }

  model InvoiceItem {
    id          Int            @id(map: "InvoiceItem_pkey") @default(autoincrement())
    invoiceId   Int
    projectId   Int?
    timeEntryId Int?
    description String
    quantity    Numeric(10, 4)
    unitPrice   Numeric(10, 4)
    total       Numeric(10, 4)
    invoice     Invoice        @relation(fields: [invoiceId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "InvoiceItem_invoiceId_fkey", index: false)
    project     Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "InvoiceItem_projectId_fkey", index: false)
    timeEntry   TimeEntry?     @relation(fields: [timeEntryId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "InvoiceItem_timeEntryId_fkey", index: false)
  }

  model LanguagePair {
    id           Int        @id(map: "LanguagePair_pkey") @default(autoincrement())
    occupationId Int
    fromLanguage String
    toLanguage   String
    occupation   Occupation @relation(fields: [occupationId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "LanguagePair_occupationId_fkey", index: false)
  }

  model OAuthAccount {
    id         Int    @id(map: "OAuthAccount_pkey") @default(autoincrement())
    provider   String
    providerId String
    userId     Int
    user       User   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "OAuthAccount_userId_fkey", index: false)

    @@index([provider, providerId], map: "OAuthAccount_provider_providerId_key", unique: true)
  }

  model PasswordResetToken {
    id        Int                @id(map: "PasswordResetToken_pkey") @default(autoincrement())
    userId    Int
    tokenHash String
    expiresAt TimestampString(3)
    createdAt TimestampString(3) @default(now())
    user      User               @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "PasswordResetToken_userId_fkey", index: false)

    @@index([tokenHash], map: "PasswordResetToken_tokenHash_key", unique: true)
  }

  model ProjectOccupation {
    projectId    Int
    occupationId Int
    occupation   Occupation @relation(fields: [occupationId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "ProjectOccupation_occupationId_fkey", index: false)
    project      Project    @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "ProjectOccupation_projectId_fkey", index: false)

    @@id([projectId, occupationId], map: "ProjectOccupation_pkey")
  }

  model RefreshToken {
    id        Int                @id(map: "RefreshToken_pkey") @default(autoincrement())
    tokenHash String
    userId    Int
    expiresAt TimestampString(3)
    createdAt TimestampString(3) @default(now())
    user      User               @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "RefreshToken_userId_fkey", index: false)

    @@index([tokenHash], map: "RefreshToken_tokenHash_key", unique: true)
  }

  model TaskActivity {
    id          Int                @id(map: "TaskActivity_pkey") @default(autoincrement())
    taskId      Int?
    userId      Int
    _type       String             @map("type")
    payload     String?
    createdAt   TimestampString(3) @default(now())
    timeEntryId Int?
    task        Task?              @relation(fields: [taskId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "TaskActivity_taskId_fkey", index: false)
    timeEntry   TimeEntry?         @relation(fields: [timeEntryId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "TaskActivity_timeEntryId_fkey", index: false)
    user        User               @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "TaskActivity_userId_fkey", index: false)
  }

  model TaskAttachment {
    id            Int                @id(map: "TaskAttachment_pkey") @default(autoincrement())
    taskId        Int
    _type         String             @map("type")
    fileName      String?
    url           String
    displayText   String?
    createdAt     TimestampString(3) @default(now())
    storageDriver String?
    storageKey    String?
    task          Task               @relation(fields: [taskId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "TaskAttachment_taskId_fkey", index: false)
  }

  model TaskComment {
    id        Int                @id(map: "TaskComment_pkey") @default(autoincrement())
    taskId    Int
    authorId  Int
    body      String
    createdAt TimestampString(3) @default(now())
    updatedAt TimestampString(3)
    author    User               @relation(fields: [authorId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "TaskComment_authorId_fkey", index: false)
    task      Task               @relation(fields: [taskId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "TaskComment_taskId_fkey", index: false)
  }

  model TaskLabel {
    id        Int                @id(map: "TaskLabel_pkey") @default(autoincrement())
    taskId    Int
    name      String
    color     String             @default("#6B7280")
    createdAt TimestampString(3) @default(now())
    task      Task               @relation(fields: [taskId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "TaskLabel_taskId_fkey", index: false)
  }

  model TimeEntryTag {
    timeEntryId Int
    tagId       Int
    tag         Tag       @relation(fields: [tagId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "TimeEntryTag_tagId_fkey", index: false)
    timeEntry   TimeEntry @relation(fields: [timeEntryId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "TimeEntryTag_timeEntryId_fkey", index: false)

    @@id([timeEntryId, tagId], map: "TimeEntryTag_pkey")
  }

  model TranslationRate {
    id             Int                @id(map: "TranslationRate_pkey") @default(autoincrement())
    userId         Int
    _type          pg.enum(RateType)  @map("type")
    name           String
    amount         Float
    currency       String             @default("EUR")
    description    String?
    createdAt      TimestampString(3) @default(now())
    updatedAt      TimestampString(3)
    clientId       Int?
    sourceLanguage VarChar(2)?
    targetLanguage VarChar(2)?
    occupationId   Int?
    client         Client?            @relation(fields: [clientId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "TranslationRate_clientId_fkey", index: false)
    occupation     Occupation?        @relation(fields: [occupationId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "TranslationRate_occupationId_fkey", index: false)
    user           User               @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "TranslationRate_userId_fkey", index: false)
  }

  model TwoFactorBackupCode {
    id        Int                 @id(map: "TwoFactorBackupCode_pkey") @default(autoincrement())
    userId    Int
    codeHash  String
    usedAt    TimestampString(3)?
    createdAt TimestampString(3)  @default(now())
    user      User                @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "TwoFactorBackupCode_userId_fkey", index: false)
  }

  native_enum ChargeType {
    FIXED = "FIXED"
    VARIABLE = "VARIABLE"
  }

  native_enum ClientIndustry {
    HEALTHCARE = "HEALTHCARE"
    EDUCATION = "EDUCATION"
    LEGAL = "LEGAL"
    FINANCE = "FINANCE"
    TECHNOLOGY = "TECHNOLOGY"
    VIDEO_GAMES = "VIDEO_GAMES"
    MARKETING = "MARKETING"
    MEDIA_ENTERTAINMENT = "MEDIA_ENTERTAINMENT"
    E_COMMERCE = "E_COMMERCE"
    MANUFACTURING = "MANUFACTURING"
    AUTOMOTIVE = "AUTOMOTIVE"
    GOVERNMENT = "GOVERNMENT"
    NGO = "NGO"
    REAL_ESTATE = "REAL_ESTATE"
    OTHER = "OTHER"
    TOURISM = "TOURISM"
    LUXE = "LUXE"
    TRANSLATION_AGENCY = "TRANSLATION_AGENCY"
  }

  native_enum ClientStatus {
    TO_CONTACT = "TO_CONTACT"
    CONTACTED = "CONTACTED"
    FOLLOW_UP_1 = "FOLLOW_UP_1"
    FOLLOW_UP_2 = "FOLLOW_UP_2"
    TALKING = "TALKING"
    CLIENT = "CLIENT"
    RECONTACT_LATER = "RECONTACT_LATER"
    FORMER_CLIENT = "FORMER_CLIENT"
  }

  native_enum ClientType {
    COMPANY = "COMPANY"
    INDIVIDUAL = "INDIVIDUAL"
  }

  native_enum InvoiceStatus {
    DRAFT = "DRAFT"
    SENT = "SENT"
    PAID = "PAID"
    OVERDUE = "OVERDUE"
    CANCELLED = "CANCELLED"
  }

  native_enum InvoicingStatus {
    NO = "NO"
    INVOICED = "INVOICED"
  }

  native_enum OccupationType {
    TRANSLATOR = "TRANSLATOR"
    CORRECTOR = "CORRECTOR"
    CUSTOM = "CUSTOM"
  }

  native_enum ProjectStatus {
    DRAFT = "DRAFT"
    ACTIVE = "ACTIVE"
    COMPLETED = "COMPLETED"
    CANCELLED = "CANCELLED"
    ARCHIVED = "ARCHIVED"
    INVOICE_SENT = "INVOICE_SENT"
    INVOICE_PAID = "INVOICE_PAID"
  }

  native_enum RateType {
    HOURLY = "HOURLY"
    PER_WORD = "PER_WORD"
    FIXED = "FIXED"
    DAY = "DAY"
  }

  native_enum Role {
    ADMIN = "ADMIN"
    MANAGER = "MANAGER"
    USER = "USER"
  }

  native_enum TaskStatus {
    TODO = "TODO"
    IN_PROGRESS = "IN_PROGRESS"
    DONE = "DONE"
    PAID = "PAID"
  }
}
